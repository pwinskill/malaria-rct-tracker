# Copy to .env (git-ignored) and fill in. Never commit the real file.

# Required for screening.mode: llm and extraction.mode: llm.
# Pay-as-you-go key from https://console.anthropic.com - separate from a
# Claude.ai subscription. Use a dedicated key in a spend-limited workspace:
# a runaway backfill is the main way this project can cost real money.
ANTHROPIC_API_KEY=

# Optional, free. Raises PubMed rate limits from 3 to 10 requests/second,
# which materially speeds up long backfills.
# https://account.ncbi.nlm.nih.gov/settings/
NCBI_API_KEY=
